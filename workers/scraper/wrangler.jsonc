{
    // dailyborg-scraper: reads the RSS feeds and queues new stories for dailyborg-ingest.
    // Account: Pressroom@dailyborg.com. Uses KV (SENTINEL_CACHE) for 24h dedup, no D1. No secrets.
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "dailyborg-scraper",
    "main": "src/index.ts",
    "compatibility_date": "2026-03-05",
    "queues": {
        "producers": [
            {
                "queue": "ingest-queue",
                "binding": "INGEST_QUEUE"
            }
        ]
    },
    "kv_namespaces": [
        {
            "binding": "SENTINEL_CACHE",
            "id": "5a2f3f363bce4eceb61dd765686b2dc4"
        }
    ],
    "triggers": {
        "crons": ["50 */2 * * *"]
    },
    "observability": { "enabled": true }
}
